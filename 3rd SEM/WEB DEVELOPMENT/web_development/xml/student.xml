<!DOCTYPE students [
  <!ELEMENT students (student+)>
  <!ELEMENT student (name, address+, phone, website)>
  <!ELEMENT name (#PCDATA)>
  <!ELEMENT address (#PCDATA)>
  <!ATTLIST address type (permanent | temporary) #REQUIRED>
  <!ELEMENT phone (#PCDATA)>
  <!ELEMENT website (#PCDATA)>
]>

<students>
  <student>
    <name>ishan</name>
    <address type="permanent">nepal</address>
    <address type="temporary">india</address>
    <phone>9767776979</phone>
    <website>ishangohome.com</website>
  </student>
</students>


<!DOCTYPE TVSCHEDULE[
<!ELEMENT TVSCHEDULE (channel+) >
<!ATTLIST TVSCHEDULE  Name #REQUIRED >

<!ATTLIST channel  chan #REQUIRED >
<!ELEMENT channel(banner,day*) >
<!ELEMENT banner (#PCDATA)>

<!ELEMENT day (date,(programslot|holiday)*) >
<!ELEMENT date (#PCDATA)> 
<!ELEMENT programslot & holiday (#PCDATA)>

<!ELEMENT programslot(time,title,description) >
<!ATTLIST programslot vtr #IMPLIED >
<!ELEMENT time (#PCDATA)>
<!ELEMENT title (#PCDATA)>
<!ATTLIST title (rating&language) #IMPLIED >
<!ELEMENT description (#PCDATA) #IMPLIED>


]>

<TVSCHEDULE Name="">
    <channel chan="">
        <banner> </banner>
        <day>
            <date> </date>
            <programslot vtr="">
                <time> </time>
                <title rating=""> </title>
                <title language=""> </title>
            <description> </description>

        </day>   
    </channel>
</TVSCHEDULE>






<!DOCTYPE Books[
<!ELEMENT books(book)>
<!ELEMENT book(title?,isbn+,zipcode,publish*)>
<!ELEMENT title (#PCDATA) >
<!ELEMENT isbn (#PCDATA) >
<!ELEMENT (zipcode|author) (#PCDATA) >
<!ELEMENT publish (#PCDATA) >
<!ELEMENT zipcode (#PCDATA) >
<!ELEMENT author (#PCDATA) >
<!ATTLIST  zipcode Zname "232232323" #FIXED>
<!ELEMENT publish (#PCDATA) >
<!ATTLIST  publish year "1995" #FIXED>
<!ATTLIST  title name  #IMPLIED>
<!ATTLIST  isbn  no #REQUIRED>




]>


<Books>
    <book>
        <title name="">
        <isbn no="" >
        <zipcode Zname="232232323">
        <publish year="1995">
    </book>
</Books>


